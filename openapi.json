{
  "openapi": "3.1.0",
  "info": {
    "title": "Flock Meter API",
    "description": "A read-only, documented facade over Urja Meter Ops.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meters": {
      "get": {
        "summary": "List Meters",
        "operationId": "list_meters_v1_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "default": "",
              "title": "Q"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meters/{meter_id}/geo": {
      "get": {
        "summary": "Meter Geo",
        "operationId": "meter_geo_v1_meters__meter_id__geo_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoCoordinates"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meters/{meter_id}/energy": {
      "get": {
        "summary": "Meter Energy",
        "operationId": "meter_energy_v1_meters__meter_id__energy_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnergyReadings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meters/export": {
      "get": {
        "summary": "Export Meters",
        "operationId": "export_meters_v1_meters_export_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterExport"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnergyReading": {
        "properties": {
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "kwh": {
            "type": "number",
            "title": "Kwh"
          },
          "kvah": {
            "type": "number",
            "title": "Kvah"
          },
          "volt_r": {
            "type": "number",
            "title": "Volt R"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "kwh",
          "kvah",
          "volt_r"
        ],
        "title": "EnergyReading"
      },
      "EnergyReadings": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/EnergyReading"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "EnergyReadings"
      },
      "GeoCoordinates": {
        "properties": {
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "GeoCoordinates"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HierarchyNode": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "title": "HierarchyNode"
      },
      "MeterExport": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/MeterRecord"
            },
            "type": "array",
            "title": "Data"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "data",
          "total"
        ],
        "title": "MeterExport"
      },
      "MeterHierarchy": {
        "properties": {
          "zone": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "circle": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "division": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "subdivision": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "substation": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "feeder": {
            "$ref": "#/components/schemas/HierarchyNode"
          },
          "dt": {
            "$ref": "#/components/schemas/HierarchyNode"
          }
        },
        "type": "object",
        "required": [
          "zone",
          "circle",
          "division",
          "subdivision",
          "substation",
          "feeder",
          "dt"
        ],
        "title": "MeterHierarchy"
      },
      "MeterPage": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/MeterSummary"
            },
            "type": "array",
            "title": "Data"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size",
            "default": 20
          }
        },
        "type": "object",
        "required": [
          "data",
          "total",
          "page"
        ],
        "title": "MeterPage"
      },
      "MeterRecord": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "serial_no": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serial No"
          },
          "make": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Make"
          },
          "phase_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase Type"
          },
          "install_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Install Status"
          },
          "dt_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dt Code"
          },
          "install_type": {
            "type": "string",
            "title": "Install Type"
          },
          "build": {
            "type": "string",
            "title": "Build"
          },
          "hierarchy": {
            "$ref": "#/components/schemas/MeterHierarchy"
          },
          "geo": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Geo"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "meter_id",
          "install_type",
          "build",
          "hierarchy",
          "geo"
        ],
        "title": "MeterRecord"
      },
      "MeterSummary": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "serial_no": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serial No"
          },
          "make": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Make"
          },
          "phase_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase Type"
          },
          "install_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Install Status"
          },
          "dt_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dt Code"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "meter_id"
        ],
        "title": "MeterSummary",
        "description": "Fields observed in the portal's meter-list UI."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
