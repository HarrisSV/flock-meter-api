# Credentials are read only from this file/environment; never commit real values.
URJA_BASE_URL=https://urja-ops.flockenergy.tech
URJA_EMAIL=operator@urja.local
URJA_PASSWORD=replace-me

# The confirmed list endpoint. Keep the unknown detail routes configurable until
# you have verified them in your browser's Network panel.
URJA_SEARCH_PATH=/portal/meters/search
URJA_GEO_PATH_TEMPLATE=/portal/meters/{meter_id}/geo
URJA_ENERGY_PATH_TEMPLATE=/portal/meters/{meter_id}/energy

